# ---------------------------------------------------------------------------
# HARD RULE: no WRDS-derived content in git, ever. The build writes here; none of
# it is ever committed. Only code, configs, and checksums live in the repo.
# ---------------------------------------------------------------------------
data/
results/
*.parquet
*.csv

# ...except the tiny SYNTHETIC example artifacts, which are safe to commit.
!examples/*.parquet

# ...and the canonical row index (grid_row, firm, origin) the Full-sample mask
# is a bitmap over: a coverage index only, no reported figures. Shipped in-repo
# so review needs no external download. Maintainer-approved as safe to publish.
!artifacts/*.parquet

# ...and the published canonical regularization stats: aggregate per-(feature,
# quarter) mu/sigma/k moments (NOT firm-level data), shipped so
# `build --reg-stats canonical` can pin the eval space to the paper. Maintainer-
# approved as safe to publish.
!src/proforma20q/reference/*.parquet

# ...and the pinned canonical id maps (account/industry embedding orderings):
# derived entirely from the in-repo task config and FF48 table -- item names and
# integer ids, no WRDS data of any kind. Deliberately NOT a bare `reference/*.csv`:
# the firm map is vintage-dependent WRDS-derived membership and must never be
# committed, so only the two data-independent maps are un-ignored.
!src/proforma20q/reference/account_id_map__*.csv
!src/proforma20q/reference/industry_id_map__*.csv

# WRDS credentials must never be committed.
.pgpass
*.pgpass

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
